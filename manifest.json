{
  "manifest_version": 2,
  "name": "Twitch Chat Watcher",
  "version": "2.2.0",
  "description": "Highlights and beeps when people on your watchlist chat on Twitch, plus free nametag paints you can share.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage", "notifications", "menus", "identity", "*://*.twitch.tv/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-chat-watcher@local",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/allen1versonfr/twitchchatwater-FF-extension/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["config.js", "shared.js", "paints.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["shared.js", "paints.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_popup": "ui.html",
    "default_title": "Twitch Chat Watcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui.html",
    "open_in_tab": true
  }
}
